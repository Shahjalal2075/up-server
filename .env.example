# Neon PostgreSQL connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Lomba random string (kom pokkhe 32 character). Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Frontend (Vercel) URL - comma diye ekadhik dewa jabe. Local: http://localhost:5173
CLIENT_URL=http://localhost:5173

PORT=5000

# ImgBB API key (ছবি আপলোডের জন্য) — https://api.imgbb.com/ থেকে "Get API key"
# Frontend-e kokhono boshabe na; shudhu ekhane ar Render env-e.
IMGBB_API_KEY=
